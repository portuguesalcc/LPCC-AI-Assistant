# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=

# Google Drive folder holding the approved documents (the ID from the folder URL)
GOOGLE_DRIVE_FOLDER_ID=

# Service account with read access to that folder.
# Paste the whole JSON key file as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Random secret; Vercel sends it automatically to the daily sync job.
CRON_SECRET=

# Password for the /admin "Sync now" page.
ADMIN_SYNC_SECRET=

# Optional: who to contact, shown in "I don't know" answers.
# Default: LPCC Núcleo Regional do Sul, 217 264 099 or 912 732 946
HELPLINE_TEXT=
